# Copy to .env.local for local development; set the same names in
# Vercel → Project → Settings → Environment Variables for the live site.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Account that can open /admin and receives the "new account" emails
ADMIN_EMAIL=juan.adori1991@gmail.com

# Resend → API Keys (free plan; sign up with the ADMIN_EMAIL address)
RESEND_API_KEY=
